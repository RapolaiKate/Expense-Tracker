<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:context=".HistoryActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/historyScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="vertical"
        android:overScrollMode="always"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- History Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">

                <ImageView
                    android:id="@+id/btnHistoryBack"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_back"
                    app:tint="#00C853"
                    android:contentDescription="Go back"
                    android:padding="8dp"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/tvHistoryTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/transaction_history"
                    android:textColor="#00C853"
                    android:textSize="26sp"
                    android:textStyle="bold"/>

                <View
                    android:layout_width="40dp"
                    android:layout_height="40dp"/>

            </LinearLayout>

            <!-- Filters -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Year and Month -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Year -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/year"
                            android:textColor="#00C853"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp"/>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilHistoryYear"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:boxBackgroundMode="outline"
                            app:boxBackgroundColor="#15151D"
                            app:boxStrokeColor="#00C853"
                            app:hintTextColor="#00C853"
                            app:endIconMode="dropdown_menu">

                            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                android:id="@+id/tvHistoryYear"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/year"
                                android:inputType="none"
                                android:textColor="#FFFFFF"
                                android:textColorHint="#A6A6AC"
                                android:padding="14dp"
                                android:textSize="14sp"
                                android:contentDescription="Select transaction year"/>

                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <!-- Month -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/month"
                            android:textColor="#00C853"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp"/>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilHistoryMonth"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:boxBackgroundMode="outline"
                            app:boxBackgroundColor="#15151D"
                            app:boxStrokeColor="#00C853"
                            app:hintTextColor="#00C853"
                            app:endIconMode="dropdown_menu">

                            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                android:id="@+id/tvHistoryMonth"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/month"
                                android:inputType="none"
                                android:textColor="#FFFFFF"
                                android:textColorHint="#A6A6AC"
                                android:padding="14dp"
                                android:textSize="14sp"
                                android:contentDescription="Select transaction month"/>

                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                </LinearLayout>

                <!-- Transaction Type -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Transaction Type"
                        android:textColor="#00C853"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"/>

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/toggleHistoryType"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        app:singleSelection="true"
                        app:selectionRequired="true"
                        app:checkedButton="@id/btnFilterAllTypes">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnFilterAllTypes"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="All Types"
                            android:textSize="11sp"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:checkable="true"
                            app:backgroundTint="#15151D"
                            app:strokeColor="#00C853"
                            app:strokeWidth="1dp"
                            app:cornerRadius="8dp"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnFilterIncome"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="Income"
                            android:textSize="11sp"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:checkable="true"
                            app:backgroundTint="#15151D"
                            app:strokeColor="#00C853"
                            app:strokeWidth="1dp"
                            app:cornerRadius="8dp"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnFilterExpense"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="Expense"
                            android:textSize="11sp"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:checkable="true"
                            app:backgroundTint="#15151D"
                            app:strokeColor="#00C853"
                            app:strokeWidth="1dp"
                            app:cornerRadius="8dp"/>

                    </com.google.android.material.button.MaterialButtonToggleGroup>

                </LinearLayout>

            </LinearLayout>

            <!-- Financial Summary -->
            <TextView
                android:id="@+id/tvFinancialSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/records"
                android:textColor="#AAAAAA"
                android:textSize="13sp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="16dp"/>

            <!-- Transaction List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTransactionHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:scrollbars="none"
                tools:listitem="@layout/item_history_transaction"/>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
