<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#000000"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="28dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_back"
                android:contentDescription="@string/back"
                android:padding="8dp"
                app:tint="#00C853" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/transaction_details"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:gravity="center"/>
        </LinearLayout>

        <!-- Transaction Type -->
        <TextView
            android:id="@+id/tvTransactionType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/expense"
            android:textColor="#00C853"
            android:textSize="16sp"
            android:textStyle="bold"
            android:padding="10dp"/>

        <!-- Amount -->
        <TextView
            android:id="@+id/tvTransactionAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/r_0"
            android:textColor="#00C853"
            android:textSize="36sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="32dp"/>

        <!-- Details Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#15151D"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/category"
                android:textColor="#AAAAAA"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/tvTransactionCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/shopping"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:paddingBottom="22dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/date"
                android:textColor="#AAAAAA"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/tvTransactionDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/date_date"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:paddingBottom="22dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/description"
                android:textColor="#AAAAAA"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/tvTransactionDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/transaction_description"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:paddingBottom="12dp"/>

        </LinearLayout>

        <!-- Edit Button -->
        <Button
            android:id="@+id/btnEditTransaction"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            android:text="@string/add_transaction"
            android:textColor="#000000"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#00C853"/>

        <!-- Delete Button -->
        <Button
            android:id="@+id/btnDeleteTransaction"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:text="@string/delete_transaction"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#D32F2F"/>

    </LinearLayout>

</ScrollView>
