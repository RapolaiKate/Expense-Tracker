<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="14dp"
    android:background="#15151D">

    <!-- Transaction Icon -->
    <ImageView
        android:id="@+id/ivTransactionIcon"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:src="@drawable/ic_save"
        android:contentDescription="@string/transaction_type"
        android:padding="9dp"
        android:background="#123524"
        app:tint="#00C853"/>

    <!-- Transaction Details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <TextView
            android:id="@+id/tvTransactionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/salary"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvTransactionCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/income"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:layout_marginTop="4dp"/>

        <TextView
            android:id="@+id/tvTransactionDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/date_date"
            android:textColor="#888888"
            android:textSize="11sp"
            android:layout_marginTop="3dp"/>

    </LinearLayout>

    <!-- Transaction Amount -->
    <TextView
        android:id="@+id/tvTransactionAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/amount"
        android:textColor="#00C853"
        android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="end"/>

</LinearLayout>
