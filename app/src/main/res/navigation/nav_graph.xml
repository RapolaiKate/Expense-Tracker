<?xml version="1.0" encoding="utf-8"?>
<navigation
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/dashboardFragment">

    <!-- DASHBOARD FRAGMENT -->
    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.kate.expensetrackerclean.ui.dashboard.DashboardFragment"
        android:label="Dashboard"
        tools:layout="@layout/activity_dashboard">

        <!-- ACTION: DASHBOARD -> ADD EXPENSE -->
        <action
            android:id="@+id/action_dashboardFragment_to_addExpenseFragment"
            app:destination="@+id/addExpenseFragment"/>

        <!-- ACTION: DASHBOARD -> UPDATE EXPENSE -->
        <action
            android:id="@+id/action_dashboardFragment_to_updateExpenseFragment"
            app:destination="@+id/updateExpenseFragment"/>

        <!-- ACTION: DASHBOARD -> STATS -->
        <action
            android:id="@+id/action_dashboardFragment_to_statsFragment"
            app:destination="@+id/statsFragment"/>

    </fragment>

    <!-- ADD EXPENSE FRAGMENT -->
    <fragment
        android:id="@+id/addExpenseFragment"
        android:name="com.kate.expensetrackerclean.ui.addexpense.AddExpenseFragment"
        android:label="Add Expense"
        tools:layout="@layout/activity_delete_transaction"/>

    <!-- UPDATE EXPENSE FRAGMENT -->
    <fragment
        android:id="@+id/updateExpenseFragment"
        android:name="com.kate.expensetrackerclean.ui.updateexpense.UpdateExpenseFragment"
        android:label="Update Expense"
        tools:layout="@layout/activity_update_transaction">

        <!-- ARGUMENT FOR EXPENSE ENTITY ID -->
        <argument
            android:name="expense"
            app:argType="com.kate.expensetrackerclean.data.database.ExpenseEntity"/>
    </fragment>

    <!-- STATS FRAGMENT -->
    <fragment
        android:id="@+id/statsFragment"
        android:name="com.kate.expensetrackerclean.ui.stats.StatsFragment"
        android:label="Stats"
        tools:layout="@layout/fragment_expense_stats"/>

</navigation>